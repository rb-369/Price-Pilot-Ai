# Client-side environment variable
# VITE_API_URL must point at the deployed backend (do NOT include a trailing slash).
# Examples:
#   Local:    VITE_API_URL=http://localhost:5000/api
#   Production: VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=https://api.your-domain.com/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
